{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pe-intelligence-web",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "observability": {
    "enabled": true,
  },

  "vars": {
    "BETTER_AUTH_URL": "https://pe-intelligence-web.rahulguptax14.workers.dev",
    "APP_URL": "https://pe-intelligence-web.rahulguptax14.workers.dev",
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "95ab9f0f669349a585d183c740d9bd27",
      "localConnectionString": "postgresql://postgres:postgres@127.0.0.1:5432/crm?sslmode=disable",
    },
  ],
}
