{
  "name": "pe-intelligence",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "cf:deploy": "bun run --filter pe-intelligence-web cf:deploy",
    "cf:versions": "bun run --filter pe-intelligence-web cf:versions",
    "dev": "turbo run dev --filter=\"./apps/*\"",
    "lint": "turbo run lint",
    "lint:oxlint": "oxlint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.78.0",
    "oxlint": "1.78.0",
    "prettier": "^3.7.4",
    "turbo": "^2.10.9",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.12"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
